{
  "common": {
    "name": "tailscale-manager",
    "version": "0.0.1",
    "news": {
      "0.0.1": {
        "en": "Initial test version with installation, connection control, timed activation and status monitoring.",
        "de": "Erste Testversion mit Installation, Verbindungssteuerung, zeitlicher Aktivierung und Statusüberwachung.",
        "ru": "Первая тестовая версия с установкой, управлением подключением, временной активацией и мониторингом состояния.",
        "pt": "Versão inicial de teste com instalação, controlo de ligação, ativação temporizada e monitorização de estado.",
        "nl": "Eerste testversie met installatie, verbindingsregeling, tijdgestuurde activering en statusbewaking.",
        "fr": "Version de test initiale avec installation, contrôle de connexion, activation temporisée et surveillance d'état.",
        "it": "Versione di test iniziale con installazione, controllo connessione, attivazione temporizzata e monitoraggio stato.",
        "es": "Versión de prueba inicial con instalación, control de conexión, activación temporizada y supervisión del estado.",
        "pl": "Pierwsza wersja testowa z instalacją, sterowaniem połączeniem, aktywacją czasową i monitorowaniem stanu.",
        "uk": "Початкова тестова версія з установленням, керуванням з'єднанням, активацією за часом і моніторингом стану.",
        "zh-cn": "初始测试版本，包含安装、连接控制、定时启用和状态监控。"
      }
    },
    "titleLang": {
      "en": "Tailscale Manager",
      "de": "Tailscale Manager",
      "ru": "Tailscale Manager",
      "pt": "Tailscale Manager",
      "nl": "Tailscale Manager",
      "fr": "Tailscale Manager",
      "it": "Tailscale Manager",
      "es": "Tailscale Manager",
      "pl": "Tailscale Manager",
      "uk": "Tailscale Manager",
      "zh-cn": "Tailscale Manager"
    },
    "desc": {
      "en": "Install, monitor and control the local Tailscale client",
      "de": "Lokalen Tailscale-Client installieren, überwachen und steuern",
      "ru": "Установка, мониторинг и управление локальным клиентом Tailscale",
      "pt": "Instalar, monitorizar e controlar o cliente Tailscale local",
      "nl": "De lokale Tailscale-client installeren, bewaken en bedienen",
      "fr": "Installer, surveiller et contrôler le client Tailscale local",
      "it": "Installa, monitora e controlla il client Tailscale locale",
      "es": "Instala, supervisa y controla el cliente Tailscale local",
      "pl": "Instaluj, monitoruj i steruj lokalnym klientem Tailscale",
      "uk": "Встановлення, моніторинг і керування локальним клієнтом Tailscale",
      "zh-cn": "安装、监控和控制本地 Tailscale 客户端"
    },
    "authors": ["TheBam <elektrobam@gmx.de>"],
    "keywords": ["tailscale", "vpn", "network", "remote access"],
    "licenseInformation": { "type": "free", "license": "MIT" },
    "platform": "Javascript/Node.js",
    "icon": "tailscale-manager.svg",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/TheBam1990/ioBroker.tailscale-manager/main/admin/tailscale-manager.svg",
    "readme": "https://github.com/TheBam1990/ioBroker.tailscale-manager/blob/main/README.md",
    "loglevel": "info",
    "mode": "daemon",
    "type": "network",
    "tier": 3,
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "adminUI": { "config": "json" },
    "dependencies": [{ "js-controller": ">=6.0.11" }],
    "globalDependencies": [{ "admin": ">=7.6.20" }]
  },
  "encryptedNative": ["authKey"],
  "protectedNative": ["authKey"],
  "native": {
    "authKey": "",
    "hostname": "",
    "acceptRoutes": false,
    "acceptDns": true,
    "advertiseRoutes": "",
    "exitNode": "",
    "pollInterval": 15,
    "defaultDurationMinutes": 60,
    "autoInstall": false
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": { "name": "Information" },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Tailscale connected",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.installed",
      "type": "state",
      "common": {
        "name": "Tailscale installed",
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.serviceRunning",
      "type": "state",
      "common": {
        "name": "Tailscale service running",
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.tunAvailable",
      "type": "state",
      "common": {
        "name": "TUN network device available",
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.setupHint",
      "type": "state",
      "common": {
        "name": "Platform setup hint",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.loginUrl",
      "type": "state",
      "common": {
        "name": "Interactive Tailscale login URL",
        "type": "string",
        "role": "text.url",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.backendState",
      "type": "state",
      "common": {
        "name": "Backend state",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": "Unknown"
      },
      "native": {}
    },
    {
      "_id": "info.version",
      "type": "state",
      "common": {
        "name": "Tailscale version",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.tailscaleIPs",
      "type": "state",
      "common": {
        "name": "Tailscale IP addresses",
        "type": "string",
        "role": "info.ip",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.dnsName",
      "type": "state",
      "common": {
        "name": "MagicDNS name",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.tailnet",
      "type": "state",
      "common": {
        "name": "Tailnet",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "info.peersOnline",
      "type": "state",
      "common": {
        "name": "Online peers",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.enabledUntil",
      "type": "state",
      "common": {
        "name": "Temporarily enabled until",
        "type": "number",
        "role": "value.time",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.remainingSeconds",
      "type": "state",
      "common": {
        "name": "Temporary connection time remaining",
        "type": "number",
        "role": "value.interval",
        "unit": "s",
        "min": 0,
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.remainingTime",
      "type": "state",
      "common": {
        "name": "Temporary connection time remaining (formatted)",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": "00:00:00"
      },
      "native": {}
    },
    {
      "_id": "info.lastUpdate",
      "type": "state",
      "common": {
        "name": "Last status update",
        "type": "number",
        "role": "value.time",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.lastError",
      "type": "state",
      "common": {
        "name": "Last error",
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    },
    {
      "_id": "control",
      "type": "channel",
      "common": { "name": "Control" },
      "native": {}
    },
    {
      "_id": "control.connected",
      "type": "state",
      "common": {
        "name": "Connect or disconnect Tailscale",
        "type": "boolean",
        "role": "switch",
        "read": true,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "control.durationMinutes",
      "type": "state",
      "common": {
        "name": "Temporary connection duration",
        "type": "number",
        "role": "level.timer",
        "unit": "min",
        "min": 1,
        "max": 10080,
        "read": true,
        "write": true,
        "def": 60
      },
      "native": {}
    },
    {
      "_id": "control.enableTimed",
      "type": "state",
      "common": {
        "name": "Enable timed connection",
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "control.install",
      "type": "state",
      "common": {
        "name": "Install Tailscale",
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "control.loginInteractive",
      "type": "state",
      "common": {
        "name": "Start interactive login",
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "control.logout",
      "type": "state",
      "common": {
        "name": "Log this device out of Tailscale",
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "control.refresh",
      "type": "state",
      "common": {
        "name": "Refresh status",
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true,
        "def": false
      },
      "native": {}
    }
  ]
}
